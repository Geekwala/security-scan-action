{
  "name": "geekwala-security-scan-action",
  "version": "1.1.0",
  "description": "GitHub Action to scan dependencies for vulnerabilities using GeekWala API",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "security",
    "vulnerability-scanning",
    "dependencies",
    "geekwala"
  ],
  "author": "GeekWala",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/github": "^6.0.0",
    "axios": "^1.6.5",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.56.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "nock": "^14.0.12",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
